{
  "info": {
    "name": "Parcial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Cómo usarla:\n1. Corre Login y copia el accessToken de la respuesta.\n2. Clic en la colección > pestaña Authorization > pega el token en Token. Todas las peticiones lo usan.\n3. El token dura 2 minutos: si sale 401, repite Login y pega el nuevo.\n\nUsuarios de db/poblar.sql:\nadmin@parcial.com / Admin-Parcial-2026\nsupervisor@parcial.com / Supervisor-Parcial-2026\nuser@parcial.com / Usuario-Parcial-2026"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@parcial.com\",\n  \"password\": \"Admin-Parcial-2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Copia el accessToken de la respuesta y pégalo en la colección > Authorization > Token."
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nuevo@parcial.com\",\n  \"password\": \"una-clave-larga-123\",\n  \"name\": \"Nuevo\",\n  \"phone\": \"3000000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"PEGA_AQUI_EL_REFRESH_TOKEN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"PEGA_AQUI_EL_REFRESH_TOKEN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Crear rol",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/roles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "roles"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role_name\": \"auditor\",\n  \"description\": \"Rol de prueba\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Listar roles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/roles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "roles"
          ]
        }
      }
    },
    {
      "name": "Mi perfil",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        }
      }
    },
    {
      "name": "Listar usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      }
    },
    {
      "name": "Asignar roles",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/PEGA_AQUI_EL_ID/roles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "PEGA_AQUI_EL_ID",
            "roles"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roles\": [\n    \"supervisor\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Cambia PEGA_AQUI_EL_ID por el id del usuario (sale en Listar usuarios)."
      }
    }
  ]
}